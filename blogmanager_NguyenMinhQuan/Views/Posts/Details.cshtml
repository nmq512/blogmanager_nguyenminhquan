@model blogmanager_NguyenMinhQuan.Models.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3>
                <i class="bi bi-file-earmark-text"></i>
                Chi tiết bài viết
            </h3>
        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>
                    <th style="width:200px">ID</th>
                    <td>@Model.Id</td>
                </tr>

                <tr>
                    <th>Tiêu đề</th>
                    <td>@Model.Title</td>
                </tr>

                <tr>
                    <th>Nội dung</th>
                    <td>@Model.Content</td>
                </tr>

                <tr>
                    <th>Tác giả</th>
                    <td>@Model.Author</td>
                </tr>
                <tr>
                    <th>Danh mục</th>
                    <td>
                        @if (Model.Category != null)
                        {
                            <span class="badge bg-primary">
                                @Model.Category.Name
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Chưa có danh mục
                            </span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Ngày xuất bản</th>
                    <td>@Model.PublishedAt.ToString("dd/MM/yyyy")</td>
                </tr>

                <tr>
                    <th>Lượt xem</th>
                    <td>
                        <span class="badge bg-info fs-6">
                            @Model.ViewCount lượt xem
                        </span>
                    </td>
                </tr>

                <tr>
                    <th>Trạng thái</th>
                    <td>
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">
                                Đã xuất bản
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Bản nháp
                            </span>
                        }
                    </td>
                </tr>

            </table>

            <div class="mt-3">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i>
                    Chỉnh sửa
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-danger">
                    <i class="bi bi-trash"></i>
                    Xóa
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại
                </a>

            </div>

        </div>

    </div>

</div>