@using blogmanager_NguyenMinhQuan.Models
@model Post

@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h3>
                <i class="bi bi-journal-plus"></i>
                Thêm bài viết
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Nhập tiêu đề bài viết..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content"
                              rows="5"
                              class="form-control"
                              placeholder="Nhập nội dung bài viết..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Author" class="form-label"></label>
                    <input asp-for="Author"
                           class="form-control"
                           placeholder="Nhập tên tác giả..." />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PublishedAt" class="form-label"></label>
                    <input asp-for="PublishedAt"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="PublishedAt" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ViewCount" class="form-label"></label>
                    <input asp-for="ViewCount"
                           class="form-control"
                           placeholder="Nhập số lượt xem..." />
                    <span asp-validation-for="ViewCount" class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i>
                    Thêm bài viết
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}