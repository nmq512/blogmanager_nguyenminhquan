@using blogmanager_NguyenMinhQuan.ViewModels
@model PostListViewModel

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h3 class="mb-0">
                <i class="bi bi-journal-text"></i>
                Danh sách bài viết
            </h3>

            <a asp-action="Create" class="btn btn-light">
                <i class="bi bi-plus-circle"></i>
                Thêm bài viết
            </a>

        </div>

        <div class="card-body">

            <!-- ========================= -->
            <!-- FORM TÌM KIẾM + LỌC -->
            <!-- ========================= -->

            <form asp-action="Index"
                  method="get"
                  class="row g-2 mb-4">

                <!-- Tìm kiếm -->
                <div class="col-md-4">

                    <input name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Nhập tiêu đề bài viết..." />

                </div>


                <!-- Lọc Category -->
                <div class="col-md-3">

                    <select name="categoryId"
                            class="form-select">

                        <option value="">
                            -- Tất cả danh mục --
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id"
                                    selected="@(Model.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Lọc Tag -->
                <div class="col-md-3">

                    <select name="tagId"
                            class="form-select">

                        <option value="">
                            -- Tất cả Tag --
                        </option>

                        @foreach (var tag in Model.Tags)
                        {
                            <option value="@tag.Id"
                                    selected="@(Model.TagId == tag.Id)">
                                @tag.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Nút tìm kiếm -->
                <div class="col-auto">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>
                        Lọc

                    </button>

                </div>


                <!-- Nút làm mới -->
                @if (!string.IsNullOrWhiteSpace(Model.Search)
                    || Model.CategoryId.HasValue
                    || Model.TagId.HasValue)
                {
                    <div class="col-auto">

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-clockwise"></i>
                            Làm mới

                        </a>

                    </div>
                }

            </form>


            <!-- ========================= -->
            <!-- DANH SÁCH POST -->
            <!-- ========================= -->

            @if (!Model.Posts.Any())
            {
                <div class="alert alert-warning">

                    <i class="bi bi-exclamation-circle"></i>

                    Không có bài viết nào phù hợp với điều kiện lọc.

                </div>
            }
            else
            {
                <table class="table table-hover table-bordered align-middle">

                    <thead class="table-dark">

                        <tr class="text-center">

                            <th>
                                Tiêu đề
                            </th>

                            <th>
                                Tác giả
                            </th>

                            <th style="width:150px">
                                Ngày đăng
                            </th>

                            <th style="width:140px">
                                Danh mục
                            </th>
                            <th style="width:220px">
                                Tag
                            </th>

                            <th style="width:140px">
                                Trạng thái
                            </th>

                            <th style="width:170px">
                                Thao tác
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var baiviet in Model.Posts)
                        {
                            <partial name="_PostRow"
                                     model="baiviet" />
                        }

                    </tbody>

                </table>
            }


            <!-- ========================= -->
            <!-- PHÂN TRANG -->
            <!-- ========================= -->

            @if (Model.TotalPages > 1)
            {
                <nav>

                    <ul class="pagination justify-content-center mb-0">


                        <!-- Trang trước -->
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-sort="@Model.Sort"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-tagId="@Model.TagId">

                                <i class="bi bi-chevron-left"></i>

                            </a>

                        </li>


                        <!-- Các trang -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@Model.Search"
                                   asp-route-sort="@Model.Sort"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-tagId="@Model.TagId">

                                    @i

                                </a>

                            </li>
                        }


                        <!-- Trang sau -->
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-sort="@Model.Sort"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-tagId="@Model.TagId">

                                <i class="bi bi-chevron-right"></i>

                            </a>

                        </li>

                    </ul>

                </nav>
            }

        </div>

    </div>

</div>