@model Tag

<tr>
    <td>
        @Model.Id
    </td>

    <td>
        @Model.Name
    </td>

    <td class="text-center">

        <a asp-controller="Tags" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm" title="Xem chi tiết">
            <i class="bi bi-eye"></i>
            </a>

        <a asp-controller="Tags" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm" title="Sửa">
            <i class="bi bi-pencil"></i> 
            </a>

        <a asp-controller="Tags" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm" title="Xóa">
            <i class="bi bi-trash"></i>
            </a>

    </td>
</tr>