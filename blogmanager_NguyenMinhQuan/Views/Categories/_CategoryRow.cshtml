@using blogmanager_NguyenMinhQuan.Models
@model Category

<tr>
    <td>@Model.Id</td>

    <td>@Model.Name</td>

    <td>
        <a asp-controller="Categories"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-info btn-sm">
            Xem chi tiết
        </a>

        <a asp-controller="Categories"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning btn-sm">
            Sửa
        </a>

        <a asp-controller="Categories"
           asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger btn-sm">
            Xóa
        </a>
    </td>
</tr>